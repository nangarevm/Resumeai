{
  "name": "resumeproof",
  "version": "1.0.0",
  "private": true,
  "description": "ResumeProof — evidence-based candidate matching, claim verification, and honest resume optimization.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:clean": "rm -rf .next .next-dev && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@react-pdf/renderer": "^4.6.1",
    "docx": "^9.7.1",
    "jose": "^6.2.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
