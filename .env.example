# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real secrets.

# Required for AI-assisted resume tailoring. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required — any random string works for local dev (NextAuth signs session tokens with it).
NEXTAUTH_SECRET=

# Optional — only needed once you're running behind a real domain (not required for localhost).
# NEXTAUTH_URL=http://localhost:3000

# Optional — enables Google sign-in. See docs/deploy.md for setup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — enables GitHub sign-in. See docs/deploy.md for setup.
# GITHUB_ID=
# GITHUB_SECRET=

# Optional — enables real email delivery for magic links / password reset.
# Without these, the app returns the link directly in the API response instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false

# Optional — enables the weekly digest cron endpoint (POST /api/cron/digest).
# Point an external scheduler (Vercel Cron, a GitHub Actions cron job, etc.) at
# it roughly weekly with "Authorization: Bearer <this value>". Without it the
# endpoint returns 501 rather than being a public "email every user" route.
# CRON_SECRET=
